{
  "name": "homonoid-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "showcase"
  ],
  "scripts": {
    "setup:showcase": "node tools/setup-homonoid.mjs showcase",
    "dev": "npm run dev --workspace=showcase",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}